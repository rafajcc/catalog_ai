# Environment Variables for Catalog AI

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Optional file logging (in addition to console). LOG_FILE may be absolute or
# relative; relative paths resolve from the app folder, so e.g. LOG_FILE=../logs/catalog_ai.log
# puts the file in a "logs" folder next to the app. The parent directory is
# created automatically. Leave empty/undefined to log only to console. The
# resolved path is printed on startup ("File logging enabled").
LOG_FILE=
# Optional: directory for the log file; useful with a bare LOG_FILE name.
# Relative LOG_DIR resolves from the app folder too.
LOG_DIR=
# Optional: rotation mode. daily -> one archive per day (<file>.YYYY-MM-DD,
# keeping LOG_MAX_FILES archives); size -> rotate when the file reaches
# LOG_MAX_SIZE (default); off -> never rotate.
LOG_ROTATION=
# Optional: maximum size before a "size" rotation (bytes, or kb/mb/gb suffix).
# Default: 10mb. Set 0 to disable size rotation.
LOG_MAX_SIZE=10mb
# Optional: number of rotated archives to keep (for "size": <file>.1 .. <file>.N;
# for "daily": <file>.YYYY-MM-DD). Default: 5. Set 0 to truncate instead of
# archiving.
LOG_MAX_FILES=5

# Optional. Development only: CORS origin (ignored when NODE_ENV=production).
# Also used as a fallback origin for mock autocomplete images when the request
# Host header cannot be used. Not required in production.
FRONTEND_URL=http://localhost:5173

# Security secrets (REQUIRED in production - change these to long random strings)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret

# Super admin (optional). Both must be set for the super admin account to exist:
#   ADMIN_USER is the plaintext username; ADMIN_PASSWORD must be a bcrypt hash of
#   the password (rounds 12), NOT the plaintext password. Generate the hash from
#   the backend folder with:
#     node -e "const b=require('bcryptjs'); b.hash('tu-password',12).then(h=>console.log(h))"
# If either variable is missing, nobody can sign in as the super admin.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Database engine - REQUIRED. Single selector: "sqlite" (internal) or
# "mysql"/"mariadb" (external). Without DB_TYPE the app refuses to boot.
DB_TYPE=sqlite

# SQLite (internal): the database file catalogai.db is created under this
# directory. If DATA_DIR is not set, the default location is used.
DATA_DIR=.

# External MySQL/MariaDB (only when DB_TYPE=mysql or DB_TYPE=mariadb):
# DB_HOST, DB_NAME, DB_USER and DB_PASSWORD are required, otherwise the app
# refuses to boot. DB_PORT is optional (defaults to 3306); DB_SSL and
# DB_MAX_POOL are optional too.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=catalog_ai
# DB_USER=catalog_ai
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_MAX_POOL=10

# API Security (optional, defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_BODY_SIZE=10mb
