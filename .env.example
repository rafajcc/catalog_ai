# Environment Variables for Catalog AI

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Optional absolute path to append logs to a file (in addition to console).
# Leave empty/undefined to log only to console.
LOG_FILE=

# CORS (development only; ignored when NODE_ENV=production)
FRONTEND_URL=http://localhost:5173

# Security secrets (REQUIRED in production - change these to long random strings)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret

# Data directory - where the SQLite database (catalogai.db) is written.
# MUST be writable by the app process in production.
DATA_DIR=.

# API Security (optional, defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_BODY_SIZE=10mb
