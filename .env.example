# Environment Variables for Catalog AI

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Optional absolute path to append logs to a file (in addition to console).
# Leave empty/undefined to log only to console. The parent directory must
# exist; if the file cannot be written the writer fails silently.
LOG_FILE=
# Optional: rotate the log file once it reaches this size (bytes, or a kb/mb/gb
# suffix). Default: 10mb. Set 0 to disable rotation.
LOG_MAX_SIZE=10mb
# Optional: number of rotated archives to keep (<file>.1 ... <file>.N). Default: 5.
# Set 0 to truncate the file instead of archiving.
LOG_MAX_FILES=5

# Optional. Development only: CORS origin (ignored when NODE_ENV=production).
# Also used as a fallback origin for mock autocomplete images when the request
# Host header cannot be used. Not required in production.
FRONTEND_URL=http://localhost:5173

# Security secrets (REQUIRED in production - change these to long random strings)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret

# Super admin (optional). Both must be set for the super admin account to exist:
#   ADMIN_USER is the plaintext username; ADMIN_PASSWORD must be a bcrypt hash of
#   the password (rounds 12), NOT the plaintext password. Generate the hash from
#   the backend folder with:
#     node -e "const b=require('bcryptjs'); b.hash('tu-password',12).then(h=>console.log(h))"
# If either variable is missing, nobody can sign in as the super admin.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Data directory - where the SQLite database (catalogai.db) is written (used when
# DB_TYPE=sqlite). MUST be writable by the app process in production.
DATA_DIR=.

# Database backend. Defaults to "sqlite" (embedded file above). Set "mysql" or
# "mariadb" to use an external database server instead; the same schema is applied
# on boot and DATA_DIR is ignored for remote backends. PostgreSQL is not supported
# yet (a DB_* / DATABASE_URL pointing to postgres fails on boot with a clear error).
DB_TYPE=sqlite
# External database connection. Use the full URL (either variable works),
# DATABASE_URL / DB_URL must be mysql:// or mariadb:// with user and password:
#   DATABASE_URL=mysql://user:pass@host:3306/catalog_ai
# Or the individual variables (DB_PORT optional, defaults to 3306):
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=catalog_ai
# DB_USER=catalog_ai
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_MAX_POOL=10

# API Security (optional, defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_BODY_SIZE=10mb
