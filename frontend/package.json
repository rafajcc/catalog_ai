{
  "name": "catalog-ai-frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Frontend interface for Catalog AI - PrestaShop catalog import and AI enrichment",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "dev": "vite",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:app": "vitest run --testPathPattern=App.test",
    "test:dashboard": "vitest run --testPathPattern=DashboardPage",
    "test:layout": "vitest run --testPathPattern=layout",
    "test:upload": "vitest run --testPathPattern=UploadSection",
    "test:configuration": "vitest run --testPathPattern=ConfigurationForm",
    "test:validation": "vitest run --testPathPattern=ValidationPanel",
    "test:images": "vitest run --testPathPattern=ImageMatchingPanel",
    "test:ai": "vitest run --testPathPattern=SuggestionsPanel",
    "test:sync": "vitest run --testPathPattern=SyncPanel",
    "test:review": "vitest run --testPathPattern=ReviewPanel",
    "test:hooks": "vitest run --testPathPattern=(useApi|useBackendStatus)",
    "test:services": "vitest run --testPathPattern=api-service",
    "test:utils": "vitest run --testPathPattern=src/utils",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "typescript",
    "prestashop",
    "ecommerce",
    "frontend"
  ],
  "author": "",
  "license": "BUSL-1.1",
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "axios": "^1.5.0",
    "catalog-ai": "file:..",
    "date-fns": "^2.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.46.0",
    "react-icons": "^4.10.0",
    "react-toastify": "^9.1.0",
    "styled-components": "^6.1.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-testing-library": "^7",
    "globals": "latest",
    "jsdom": "^28",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "sass": "^1.69.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70",
    "vite-plugin-sass": "^0.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": {
      "vite-plugin-sass": "^0.1.0"
    },
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 8.0.0"
  },
  "browserslist": {
    "production": [
      "> 0.25%",
      "not dead",
      ">= 0.25%"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
