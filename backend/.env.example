# Environment Variables for Catalog AI

# Application Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Runtime configuration (contains encrypted secrets)
# CONFIG_FILE=./config.json
# CONFIG_SECRET=your-encryption-secret

# API Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_BODY_SIZE=10mb
